module VaultTest where

import Daml.Script
import Vault

setup : Script (Party, ContractId Vault)
setup = script do
  alice <- allocateParty "Alice"
  v <- submit alice do createCmd Vault with owner = alice; balance = 5000.0
  pure (alice, v)

testWithdrawWorks : Script ()
testWithdrawWorks = script do
  (alice, v) <- setup
  _ <- submit alice do exerciseCmd v Withdraw with amount = 10.0
  pure ()

-- ensure balance >= 0.0
testNegativeBalanceRefused : Script ()
testNegativeBalanceRefused = script do
  alice <- allocateParty "Alice2"
  submitMustFail alice do createCmd Vault with owner = alice; balance = -1.0

-- require "amount positive"
testZeroAmountRefused : Script ()
testZeroAmountRefused = script do
  (alice, v) <- setup
  submitMustFail alice do exerciseCmd v Withdraw with amount = 0.0

-- require "cannot overdraw". Without it the choice would clamp to zero and
-- succeed, so this command must be refused by the check and by nothing else.
testOverdrawRefused : Script ()
testOverdrawRefused = script do
  alice <- allocateParty "Alice3"
  v <- submit alice do createCmd Vault with owner = alice; balance = 50.0
  submitMustFail alice do exerciseCmd v Withdraw with amount = 60.0
