-- KyaTest: the attack suite for KyaMandate.
--
-- The parties are named for the situation this was built for: a business whose
-- principal is in one country and whose payouts happen in another. The
-- principal cannot be on the ground. Someone -- or something -- has to execute
-- there, and handing that operator unbounded authority over the float is the
-- thing that stops the business scaling.
--
-- Every script is named after the attack it proves, so `daml test` output IS
-- the scoreboard we take to judging. THE-RULES.md: no claim without a number
-- behind it. These are the numbers.
--
-- NOT in this file: no receipt logic. The ledger enforces; the chain observes.
module KyaTest where

import DA.Text (isInfixOf)
import DA.Time (RelTime, addRelTime, hours, minutes)
import Daml.Script
import KyaMandate

-- The principal, the operator, and the accounts a payout might reach.
--
-- recipient and settlement are on the allow-list. unverified is deliberately
-- NOT: it stands for the message every operator eventually receives --
-- "change of account, send it here instead" -- whether that comes from a
-- compromised customer, a socially engineered operator, or the operator
-- itself. It is the most common way money leaves a business like this.
data Book = Book with
  principal  : Party   -- holds the authority, is not in the country
  operator   : Party   -- executes payouts on the ground; the spender
  recipient  : Party   -- a verified customer, on the allow-list
  settlement : Party   -- the liquidity/settlement partner, on the allow-list
  unverified : Party   -- the account nobody authorised

-- A live mandate: cap 100, two allow-listed destinations, expiring `life` from now.
bookWithExpiry : RelTime -> Script (Book, ContractId KyaMandate)
bookWithExpiry life = script do
  principal  <- allocateParty "Principal"
  operator   <- allocateParty "Operator"
  recipient  <- allocateParty "VerifiedRecipient"
  settlement <- allocateParty "SettlementPartner"
  unverified <- allocateParty "UnverifiedAccount"
  now <- getTime

  -- Propose and accept. The mandate needs BOTH signatures, so the agent
  -- consents to its own leash. This is what makes every receipt's
  -- "approved_by" line literally true.
  prop <- submit principal do
    createCmd KyaMandateProposal with
      owner = principal
      spender = operator
      cap = 100.0
      expiresAt = addRelTime now life
      allowed = [recipient, settlement]
      periodLimit = None
      periodLength = None
  m <- submit operator do exerciseCmd prop Accept

  let b = Book with principal; operator; recipient; settlement; unverified
  pure (b, m)

book : Script (Book, ContractId KyaMandate)
book = bookWithExpiry (hours 24)

-- 1. The desk settles two legs inside its cap, to allow-listed destinations.
--    No owner signature needed for either. That is the point of a mandate.
testChargeUnderCapAccepted : Script ()
testChargeUnderCapAccepted = script do
  (b, m0) <- book
  m1 <- submit b.operator do
    exerciseCmd m0 Charge with
      amount = 40.0; payee = b.recipient; memo = "payout to verified recipient"
  _ <- submit b.operator do
    exerciseCmd m1 Charge with
      amount = 35.0; payee = b.settlement; memo = "settlement partner leg"
  pure ()

-- 2. 40 + 35 = 75 spent. A further 60 would reach 135 against a cap of 100.
--    Refused by the cap assertion in the Charge body.
testOverCapRefused : Script ()
testOverCapRefused = script do
  (b, m0) <- book
  m1 <- submit b.operator do
    exerciseCmd m0 Charge with amount = 40.0; payee = b.recipient; memo = "payout 1"
  m2 <- submit b.operator do
    exerciseCmd m1 Charge with amount = 35.0; payee = b.settlement; memo = "payout 2"
  submitMustFail b.operator do
    exerciseCmd m2 Charge with
      amount = 60.0; payee = b.recipient; memo = "would exceed the cap"

-- 3. THE ONE THAT MATTERS.
--    "Change of account, send it here instead." The operator is persuaded to
--    pay somewhere the principal never authorised. Refused by the allow-list
--    assertion in the Charge body -- and note the operator does not have to be
--    dishonest for this to happen, only convinced.
--
--    The same amount is then paid to an ALLOW-LISTED account and succeeds.
--    That proves the refusal is about WHO, not about HOW MUCH -- it cannot be
--    dismissed as a cap artefact.
testPayoutRedirectionRefused : Script ()
testPayoutRedirectionRefused = script do
  (b, m0) <- book
  submitMustFail b.operator do
    exerciseCmd m0 Charge with
      amount = 10.0
      payee = b.unverified
      memo = "change of account, send it here instead"
  _ <- submit b.operator do
    exerciseCmd m0 Charge with
      amount = 10.0; payee = b.recipient; memo = "same amount, to the account the principal authorised"
  pure ()

-- 4. The principal revokes, from wherever they are. Revoke is consuming and
--    creates nothing, so the mandate stops existing. There is no flag to race
--    and nothing left to charge against, and the operator cannot block or
--    delay it -- which is the whole point of being able to stop a payout
--    channel you are not standing next to.
testAfterRevokeRefused : Script ()
testAfterRevokeRefused = script do
  (b, m0) <- book
  submit b.principal do exerciseCmd m0 Revoke
  submitMustFail b.operator do
    exerciseCmd m0 Charge with
      amount = 5.0; payee = b.recipient; memo = "after the principal revoked"

-- 5. Expiry. A field called expiresAt enforces nothing on its own -- the
--    assertion in the Charge body is what makes it a rule. The organisers
--    call this out as a real audit finding on production Canton code.
testAfterExpiryRefused : Script ()
testAfterExpiryRefused = script do
  (b, m0) <- bookWithExpiry (hours 1)
  passTime (hours 2)
  submitMustFail b.operator do
    exerciseCmd m0 Charge with
      amount = 5.0; payee = b.recipient; memo = "after the mandate expired"

-- 6. The operator cannot widen its own limit: Adjust needs BOTH signatures.
--    Then the principal signs alongside it and the same change succeeds, which
--    shows the fence has a gate and only the principal holds the key to it.
testSpenderCannotRaiseOwnCap : Script ()
testSpenderCannotRaiseOwnCap = script do
  (b, m0) <- book
  submitMustFail b.operator do exerciseCmd m0 Adjust with newCap = 100000.0
  _ <- submitMulti [b.principal, b.operator] [] do
    exerciseCmd m0 Adjust with newCap = 200.0
  pure ()

-- 7. The principal cannot spend through the operator's choice either.
--    `controller spender` IS the check; nobody wrote a permission layer for it.
--    Authority here is separated in both directions, not just downwards.
testOwnerCannotChargeAsSpender : Script ()
testOwnerCannotChargeAsSpender = script do
  (b, m0) <- book
  submitMustFail b.principal do
    exerciseCmd m0 Charge with
      amount = 1.0; payee = b.recipient; memo = "principal using the operator's choice"

-- 8. An accepted charge leaves a record ON THE LEDGER, not only in our receipt
--    chain. The owner and the payee can both read it; a party who was not
--    involved cannot. `observer payee` is what makes the payee's half true,
--    and it gives them no power to authorise anything.
testChargeRecordReadableByOwnerAndPayee : Script ()
testChargeRecordReadableByOwnerAndPayee = script do
  (b, m0) <- book
  _ <- submit b.operator do
    exerciseCmd m0 Charge with
      amount = 40.0; payee = b.recipient; memo = "payout to verified recipient"
  byOwner    <- query @ChargeRecord b.principal
  byPayee    <- query @ChargeRecord b.recipient
  byOutsider <- query @ChargeRecord b.unverified
  assertMsg "owner cannot read the charge record"          (length byOwner == 1)
  assertMsg "payee cannot read their own payment record"   (length byPayee == 1)
  assertMsg "an uninvolved party can read the record"      (null byOutsider)

-- 9. A REFUSED charge leaves nothing on the ledger. The whole transaction
--    rolls back, record included. That is precisely why the receipt chain
--    exists: the ledger keeps what happened, the chain keeps what was TRIED.
testRefusedChargeLeavesNoRecord : Script ()
testRefusedChargeLeavesNoRecord = script do
  (b, m0) <- book
  submitMustFail b.operator do
    exerciseCmd m0 Charge with
      amount = 10.0; payee = b.unverified; memo = "unauthorised account"
  recs <- query @ChargeRecord b.principal
  assertMsg "a refused charge left a record on the ledger" (null recs)

-- 11. THE TEST THAT TESTS THE TESTS.
--
--     testOverCapRefused above uses submitMustFail, which proves only that
--     SOMETHING refused. Mutation testing found that this is not enough: delete
--     the cap assertion and that test still passes, because `ensure spent <= cap`
--     on the template catches the same condition. The cap is deliberately
--     enforced twice and the money is safe either way -- but a green
--     submitMustFail cannot tell you the assertion is still alive.
--
--     assertMsg throws AssertionFailed carrying its message; a failed `ensure`
--     throws PreconditionFailed. Both arrive as UnhandledException, so casting
--     tells them apart. Delete the assertion now and this test goes red.
testOverCapRefusedByTheCapAssertion : Script ()
testOverCapRefusedByTheCapAssertion = script do
  (b, m0) <- book
  m1 <- submit b.operator do
    exerciseCmd m0 Charge with amount = 40.0; payee = b.recipient; memo = "payout 1"
  m2 <- submit b.operator do
    exerciseCmd m1 Charge with amount = 35.0; payee = b.settlement; memo = "payout 2"
  result <- trySubmit b.operator do
    exerciseCmd m2 Charge with
      amount = 60.0; payee = b.recipient; memo = "would exceed the cap"
  case result of
    Left (FailureStatusError fs) ->
      assertMsg ("refused, but not by the cap rule: " <> fs.message)
                ("charge would exceed the cap" `isInfixOf` fs.message)
    Left _ ->
      assertMsg "refused by something other than an assertion in the choice body" False
    Right _ ->
      assertMsg "THE OVER-CAP CHARGE WAS ACCEPTED" False


-- ---------------------------------------------------------------------------
-- Per-period limits. The brief warned that this "looks simple and turns into
-- date arithmetic", so these tests attack the arithmetic, not just the limit.
-- ---------------------------------------------------------------------------

-- A mandate with a daily-style window: cap 100 overall, but no more than 20
-- inside any window of `len`.
cappedPerPeriod : RelTime -> Script (Book, ContractId KyaMandate)
cappedPerPeriod len = script do
  principal  <- allocateParty "Principal"
  operator   <- allocateParty "Operator"
  recipient  <- allocateParty "VerifiedRecipient"
  settlement <- allocateParty "SettlementPartner"
  unverified <- allocateParty "UnverifiedAccount"
  now <- getTime
  prop <- submit principal do
    createCmd KyaMandateProposal with
      owner = principal
      spender = operator
      cap = 100.0
      expiresAt = addRelTime now (hours 24)
      allowed = [recipient, settlement]
      periodLimit = Some 20.0
      periodLength = Some len
  m <- submit operator do exerciseCmd prop Accept
  let bk = Book with principal; operator; recipient; settlement; unverified
  pure (bk, m)

-- Spend one full period limit, then step past the window, `i` times over.
-- Top level because Daml does not permit recursive local bindings.
drainWindows : Party -> Party -> ContractId KyaMandate -> Int
            -> Script (ContractId KyaMandate)
drainWindows operator recipient m i =
  if i == 0 then pure m
  else do
    m' <- submit operator do
      exerciseCmd m Charge with
        amount = 20.0; payee = recipient; memo = "window payout"
    passTime (minutes 2)
    drainWindows operator recipient m' (i - 1)

-- 12. Two payouts inside one window that together breach the period limit.
--     Both are far below the total cap of 100, so only the period fence can
--     refuse this.
testPeriodLimitRefusedWithinWindow : Script ()
testPeriodLimitRefusedWithinWindow = script do
  (b, m0) <- cappedPerPeriod (hours 24)
  m1 <- submit b.operator do
    exerciseCmd m0 Charge with amount = 15.0; payee = b.recipient; memo = "payout 1"
  submitMustFail b.operator do
    exerciseCmd m1 Charge with amount = 10.0; payee = b.recipient; memo = "same window"

-- 13. The same two payouts, separated by more than the window, both succeed.
--     This is the test that proves the window actually reopens -- a period
--     limit that never resets is just a smaller cap wearing a disguise.
testPeriodResetsAfterTheWindow : Script ()
testPeriodResetsAfterTheWindow = script do
  -- A one-minute window, so the clock can pass it without also passing the
  -- mandate's 24h expiry. Advancing past BOTH would prove nothing: the expiry
  -- fence would refuse the second payout and the test would look like a
  -- working period reset. That mistake is why this comment exists.
  (b, m0) <- cappedPerPeriod (minutes 1)
  m1 <- submit b.operator do
    exerciseCmd m0 Charge with amount = 15.0; payee = b.recipient; memo = "payout 1"
  passTime (minutes 2)
  _ <- submit b.operator do
    exerciseCmd m1 Charge with amount = 15.0; payee = b.recipient; memo = "next window"
  pure ()

-- 14. Waiting out a window does NOT unlock the total cap. An operator who
--     could reset the total by waiting would have an unbounded mandate given
--     enough patience, which is the failure mode a naive reset introduces.
testPeriodResetDoesNotResetTheTotalCap : Script ()
testPeriodResetDoesNotResetTheTotalCap = script do
  (b, m0) <- cappedPerPeriod (minutes 1)
  -- Five windows of 20 each reaches the total cap of 100 exactly.
  mFinal <- drainWindows b.operator b.recipient m0 5
  -- The period window is open again, but the total cap is spent.
  submitMustFail b.operator do
    exerciseCmd mFinal Charge with
      amount = 1.0; payee = b.recipient; memo = "patience should not buy more"

-- 15. The period fence and the cap fence are independent: a charge inside the
--     period limit but over the total cap is still refused.
testPeriodLimitDoesNotWeakenTheCap : Script ()
testPeriodLimitDoesNotWeakenTheCap = script do
  (b, m0) <- cappedPerPeriod (minutes 1)
  mFinal <- drainWindows b.operator b.recipient m0 4   -- 80 of 100, window fresh
  -- 20 is inside the period limit but 80 + 20 = 100 is exactly the cap, so
  -- this succeeds; 21 would breach the cap while staying inside the period.
  submitMustFail b.operator do
    exerciseCmd mFinal Charge with
      amount = 21.0; payee = b.recipient; memo = "inside the window, over the cap"

-- 16. A mandate with no period configured behaves exactly as before. The
--     Optional fields must not change the meaning of an existing mandate.
testNoPeriodConfiguredIsUnchanged : Script ()
testNoPeriodConfiguredIsUnchanged = script do
  (b, m0) <- book
  m1 <- submit b.operator do
    exerciseCmd m0 Charge with amount = 40.0; payee = b.recipient; memo = "payout 1"
  _ <- submit b.operator do
    exerciseCmd m1 Charge with amount = 35.0; payee = b.settlement; memo = "payout 2"
  pure ()

-- 17. A zero payout. `amount > 0.0` is the only fence that catches this:
--     spent + 0 leaves both `spent >= 0.0` and `spent <= cap` satisfied, so
--     the ensure invariant does not mask the assertion here. Chosen for that
--     reason -- a negative amount would be caught by ensure too and would
--     prove nothing about the assertion.
testAmountMustBePositive : Script ()
testAmountMustBePositive = script do
  (b, m0) <- book
  submitMustFail b.operator do
    exerciseCmd m0 Charge with
      amount = 0.0; payee = b.recipient; memo = "a payout of nothing"

-- 18. Adjust cannot set a cap below what has already been spent -- that would
--     leave a mandate whose own invariant is false.
--
--     `ensure spent <= cap` catches this as well, so submitMustFail alone
--     could not tell the two apart. Asserting on the message is what makes
--     this test specific to the Adjust rule.
testAdjustBelowSpentRefused : Script ()
testAdjustBelowSpentRefused = script do
  (b, m0) <- book
  m1 <- submit b.operator do
    exerciseCmd m0 Charge with amount = 40.0; payee = b.recipient; memo = "payout 1"
  result <- trySubmit (actAs [b.principal, b.operator]) do
    exerciseCmd m1 Adjust with newCap = 10.0
  case result of
    Left (FailureStatusError fs) ->
      assertMsg ("refused, but not by the Adjust rule: " <> fs.message)
                ("new cap below what is already spent" `isInfixOf` fs.message)
    Left _ -> assertMsg "refused by something other than an assertion" False
    Right _ -> assertMsg "CAP WAS LOWERED BELOW WHAT IS ALREADY SPENT" False

-- Reject had no test. A proposal the spender declines must leave nothing
-- behind: an un-rejected proposal sitting on the ledger is a mandate waiting
-- to be accepted later, by whoever still holds that contract id.
testSpenderCanRejectAProposal : Script ()
testSpenderCanRejectAProposal = script do
  owner   <- allocateParty "Principal"
  spender <- allocateParty "Operator"
  payee   <- allocateParty "VerifiedRecipient"
  now <- getTime
  prop <- submit owner do
    createCmd KyaMandateProposal with
      owner; spender; cap = 100.0
      expiresAt = addRelTime now (hours 24)
      allowed = [payee]; periodLimit = None; periodLength = None
  submit spender do exerciseCmd prop Reject
  -- Consuming: the proposal is gone, so it cannot be accepted afterwards.
  submitMustFail spender do exerciseCmd prop Accept

testOwnerCannotRejectOnTheSpendersBehalf : Script ()
testOwnerCannotRejectOnTheSpendersBehalf = script do
  owner   <- allocateParty "Principal"
  spender <- allocateParty "Operator"
  payee   <- allocateParty "VerifiedRecipient"
  now <- getTime
  prop <- submit owner do
    createCmd KyaMandateProposal with
      owner; spender; cap = 100.0
      expiresAt = addRelTime now (hours 24)
      allowed = [payee]; periodLimit = None; periodLength = None
  submitMustFail owner do exerciseCmd prop Reject

-- ---------------------------------------------------------------------------
-- THE REFUSAL AS A LEDGER FACT
--
-- Every test above this line proves the money was stopped, with
-- submitMustFail. None of them proves anything about evidence, and that gap is
-- the point of this section. A failed assertMsg aborts the transaction, so
-- after testOverCapRefused the ledger looks EXACTLY as it would look if the
-- agent had never been asked to make that payment. The only record of the
-- refusal is whatever the operator's own process wrote afterwards, about
-- itself, which is the thing a regulated issuer cannot hand anybody.
--
-- TryCharge makes the refusal a transaction that succeeds, so the refusal
-- commits. These tests hold it to both halves of that: the refusal really is
-- on the ledger with the rule that fired, and the money really did not move.

-- Attempt a charge that is expected to be refused, and return the rule the
-- ledger recorded, with the mandate's new id. TryCharge is consuming, so the
-- id changes even when nothing was spent.
tryRule : Book -> ContractId KyaMandate -> Decimal -> Party
       -> Script (Text, ContractId KyaMandate)
tryRule b m amount payee = do
  r <- submit b.operator do
    exerciseCmd m TryCharge with amount; payee; memo = "probe"
  case r.refusal of
    None -> abort "expected a refusal; the charge went through instead"
    Some rid -> do
      found <- queryContractId b.principal rid
      case found of
        None -> abort "the refusal was not on the ledger afterwards"
        Some rec -> pure (rec.rule, r.mandate)

-- 16. The refusal is on the ledger, and the money did not move.
testRefusalIsOnLedgerAndNothingMoved : Script ()
testRefusalIsOnLedgerAndNothingMoved = script do
  (b, m0) <- book
  m1 <- submit b.operator do
    exerciseCmd m0 Charge with amount = 40.0; payee = b.recipient; memo = "payout 1"
  before <- query @ChargeRecord b.principal

  r <- submit b.operator do
    exerciseCmd m1 TryCharge with
      amount = 90.0; payee = b.recipient; memo = "would exceed the cap"

  case r.refusal of
    None -> abort "an over-cap attempt produced no refusal record"
    Some rid -> do
      found <- queryContractId b.principal rid
      case found of
        None -> abort "the refusal record is not on the ledger"
        Some rec -> do
          assertMsg ("the record names the wrong rule: " <> rec.rule)
            (rec.rule == "charge would exceed the cap")
          assertMsg "the record lost the amount that was attempted"
            (rec.amount == 90.0)
          assertMsg "the record lost who it would have paid"
            (rec.payee == b.recipient)

  -- The half that matters just as much. Recording a refusal is worth nothing
  -- if recording it also lets the payment through.
  held <- queryContractId b.principal r.mandate
  case held of
    None -> abort "the mandate did not survive a refusal"
    Some m -> do
      assertMsg "a refusal moved the spent total" (m.spent == 40.0)
      assertMsg "a refusal moved the period total" (m.periodSpent == 40.0)
  after <- query @ChargeRecord b.principal
  assertMsg "a refusal created a payment record"
    (length after == length before)

-- 17. Every fence records its own reason, not a generic one.
--
--     A record that says only "refused" is barely better than no record. The
--     regulator's question is WHICH rule, and an implementation that records
--     the wrong one is worse than one that aborts, because it is confidently
--     wrong in writing.
testEveryFenceRecordsItsOwnRule : Script ()
testEveryFenceRecordsItsOwnRule = script do
  (b, m0) <- book
  (negative, m1) <- tryRule b m0 (-5.0) b.recipient
  assertMsg ("negative amount recorded as: " <> negative)
    (negative == "amount must be positive")
  (who, m2) <- tryRule b m1 10.0 b.unverified
  assertMsg ("redirected payee recorded as: " <> who)
    (who == "payee is not on the allow-list")
  (overCap, _) <- tryRule b m2 500.0 b.recipient
  assertMsg ("over-cap recorded as: " <> overCap)
    (overCap == "charge would exceed the cap")

testExpiryRecordsItsOwnRule : Script ()
testExpiryRecordsItsOwnRule = script do
  (b, m0) <- bookWithExpiry (hours 1)
  passTime (hours 2)
  (rule, _) <- tryRule b m0 5.0 b.recipient
  assertMsg ("an expired mandate recorded: " <> rule) (rule == "mandate expired")

testPeriodLimitRecordsItsOwnRule : Script ()
testPeriodLimitRecordsItsOwnRule = script do
  (b, m0) <- cappedPerPeriod (hours 24)
  -- 20 is the window limit and 25 is under the overall cap of 100, so the only
  -- rule that can fire is the period one. If the cap fired here the message
  -- would be wrong and this test would say so.
  (rule, _) <- tryRule b m0 25.0 b.recipient
  assertMsg ("over the window limit recorded: " <> rule)
    (rule == "charge would exceed the period limit")

-- 18. The accepted path is still the accepted path.
--
--     TryCharge must not become a softer Charge. An allowed payment through
--     TryCharge has to move the money and write the payment record, exactly as
--     Charge does, and leave no refusal behind.
testTryChargeAcceptedBehavesLikeCharge : Script ()
testTryChargeAcceptedBehavesLikeCharge = script do
  (b, m0) <- book
  r <- submit b.operator do
    exerciseCmd m0 TryCharge with
      amount = 30.0; payee = b.recipient; memo = "an ordinary payout"
  assertMsg "an allowed payment left a refusal record" (r.refusal == None)
  held <- queryContractId b.principal r.mandate
  case held of
    None -> abort "the mandate did not survive an accepted charge"
    Some m -> assertMsg "an accepted charge did not move the spent total"
                (m.spent == 30.0)
  recs <- query @ChargeRecord b.principal
  assertMsg "an accepted charge wrote no payment record" (length recs == 1)

-- 19. The limit, asserted so nobody sells past it.
--
--     ChargeRefused has an implicit Archive choice, like every Daml template,
--     and its signatories are the same two parties who run the agent. They CAN
--     archive a refusal. What they cannot do is make the archiving not have
--     happened: the create and the archive are both transactions with record
--     times the submitter does not write. So the honest claim is not "this
--     cannot be removed". It is "removing it is itself a recorded event, and
--     the gap is visible to anyone reading the ledger".
--
--     This is here as a test rather than a comment because a sentence in a
--     README can drift from the code and an executable assertion cannot.
testTheOperatorCanArchiveARefusalButNotSilently : Script ()
testTheOperatorCanArchiveARefusalButNotSilently = script do
  (b, m0) <- book
  r <- submit b.operator do
    exerciseCmd m0 TryCharge with
      amount = 500.0; payee = b.recipient; memo = "over the cap"
  case r.refusal of
    None -> abort "no refusal to archive"
    Some rid -> do
      -- One signatory alone cannot do it.
      submitMustFail b.operator do exerciseCmd rid Archive
      -- Both together can.
      submitMulti [b.principal, b.operator] [] do exerciseCmd rid Archive
      gone <- queryContractId b.principal rid
      assertMsg "the refusal survived an authorised archive" (gone == None)
