-- The attack suite for the two legs where the desk loses its own money.
module KyaCycleTest where

import Daml.Script
import KyaCycle

data Desk = Desk with
  principal : Party
  operator  : Party
  customer  : Party

trc : Text
trc = "TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t"

erc : Text
erc = "0x8f3aE9dB1B7B2f5F3aE44D9B3F1c8bA2E4d5C6f7"

books : Script (Desk, ContractId DepositBook, ContractId OffTakerBook)
books = script do
  principal <- allocateParty "Principal"
  operator  <- allocateParty "Operator"
  customer  <- allocateParty "Customer"
  d <- submit principal do
    createCmd DepositBook with
      principal; operator
      depositFeed = None
      addresses = [ ("USDT", "TRC20", trc, False)
                  , ("USDT", "ERC20", erc, False)
                  , ("XRP",  "XRPL",  "rEb8TK3gBgk5auZkwc6sHnwrGVJH8DuaLh", True) ]
  o <- submit principal do
    createCmd OffTakerBook with
      principal; operator
      wallets = [("Supplier A", "USDT", "TRC20", trc)]
  let desk = Desk with principal; operator; customer
  pure (desk, d, o)

-- 1. The ordinary case: right asset, right network, address handed over.
testDepositInstructionForAnApprovedNetwork : Script ()
testDepositInstructionForAnApprovedNetwork = script do
  (k, d, _) <- books
  _ <- submit k.operator do
    exerciseCmd d IssueDepositInstruction with
      customer = k.customer; quoteRef = "KYA-1"
      asset = "USDT"; network = "TRC20"; memo = None
  pure ()

-- 2. THE IRREVERSIBLE ONE. A network the desk holds no address for. Sending a
--    customer an address that does not exist on their chain does not bounce --
--    the coin is gone, and no fence later in the cycle can recover it.
testUnknownNetworkIsRefused : Script ()
testUnknownNetworkIsRefused = script do
  (k, d, _) <- books
  submitMustFail k.operator do
    exerciseCmd d IssueDepositInstruction with
      customer = k.customer; quoteRef = "KYA-2"
      asset = "USDT"; network = "BEP20"; memo = None

-- 3. The memo. On a chain that requires one, a deposit without it credits
--    nobody. The operator cannot forget it, because they cannot issue the
--    instruction without it.
testMemoRequiredNetworkRefusesAMissingMemo : Script ()
testMemoRequiredNetworkRefusesAMissingMemo = script do
  (k, d, _) <- books
  submitMustFail k.operator do
    exerciseCmd d IssueDepositInstruction with
      customer = k.customer; quoteRef = "KYA-3"
      asset = "XRP"; network = "XRPL"; memo = None

testMemoRequiredNetworkAcceptsAMemo : Script ()
testMemoRequiredNetworkAcceptsAMemo = script do
  (k, d, _) <- books
  _ <- submit k.operator do
    exerciseCmd d IssueDepositInstruction with
      customer = k.customer; quoteRef = "KYA-4"
      asset = "XRP"; network = "XRPL"; memo = Some "3391827"
  pure ()

-- 4. The operator cannot add a deposit address. Otherwise every fence above
--    is one keystroke from being their own wallet.
testOperatorCannotApproveADepositAddress : Script ()
testOperatorCannotApproveADepositAddress = script do
  (k, d, _) <- books
  submitMustFail k.operator do
    exerciseCmd d ApproveDepositAddress with
      asset = "USDT"; network = "BEP20"
      address = "0xTHEOPERATORSOWNWALLET"; memoRequired = False

-- 5. THE OFF-TAKER LEG. The desk's own crypto, sent first, to a wallet the
--    off-taker supplied. Same attack as the customer side, larger amounts,
--    and it is the desk's money rather than someone else's.
testCryptoCannotGoToAnUnapprovedOffTakerWallet : Script ()
testCryptoCannotGoToAnUnapprovedOffTakerWallet = script do
  (k, _, o) <- books
  submitMustFail k.operator do
    exerciseCmd o SendToOffTaker with
      offTaker = "Supplier A"; asset = "USDT"; network = "TRC20"
      toAddress = "TNewWalletTheySentOnWhatsAppThisMorning"
      amount = 5000.0; expectedNaira = 6250000.0

-- 6. The same off-taker, the same approved wallet, but the wrong network.
--    An approval is for one asset on one chain, not for a name.
testOffTakerApprovalIsPerNetwork : Script ()
testOffTakerApprovalIsPerNetwork = script do
  (k, _, o) <- books
  submitMustFail k.operator do
    exerciseCmd o SendToOffTaker with
      offTaker = "Supplier A"; asset = "USDT"; network = "ERC20"
      toAddress = trc; amount = 5000.0; expectedNaira = 6250000.0

testSendingToAnApprovedOffTakerWalletWorks : Script ()
testSendingToAnApprovedOffTakerWalletWorks = script do
  (k, _, o) <- books
  _ <- submit k.operator do
    exerciseCmd o SendToOffTaker with
      offTaker = "Supplier A"; asset = "USDT"; network = "TRC20"
      toAddress = trc; amount = 5000.0; expectedNaira = 6250000.0
  pure ()

-- 7. Short naira is not a judgement call made under pressure. The desk agreed
--    an amount; anything less is refused rather than argued about.
testShortNairaIsRefused : Script ()
testShortNairaIsRefused = script do
  (k, _, o) <- books
  leg <- submit k.operator do
    exerciseCmd o SendToOffTaker with
      offTaker = "Supplier A"; asset = "USDT"; network = "TRC20"
      toAddress = trc; amount = 5000.0; expectedNaira = 6250000.0
  submitMustFail k.operator do
    exerciseCmd leg ConfirmNairaReceived with received = 6000000.0

testFullNairaIsAccepted : Script ()
testFullNairaIsAccepted = script do
  (k, _, o) <- books
  leg <- submit k.operator do
    exerciseCmd o SendToOffTaker with
      offTaker = "Supplier A"; asset = "USDT"; network = "TRC20"
      toAddress = trc; amount = 5000.0; expectedNaira = 6250000.0
  _ <- submit k.operator do
    exerciseCmd leg ConfirmNairaReceived with received = 6250000.0
  pure ()

-- 8. The customer can see the instruction they were given, so "you sent me
--    the wrong address" is a question with an answer on the ledger.
testCustomerCanSeeTheInstructionTheyWereGiven : Script ()
testCustomerCanSeeTheInstructionTheyWereGiven = script do
  (k, d, _) <- books
  _ <- submit k.operator do
    exerciseCmd d IssueDepositInstruction with
      customer = k.customer; quoteRef = "KYA-9"
      asset = "USDT"; network = "TRC20"; memo = None
  seen <- query @DepositInstruction k.customer
  assertMsg "the customer cannot see their own deposit instruction" (length seen == 1)


-- ---------------------------------------------------------------------------
-- The deposit feed: the twin of the bank feed, on the crypto side. An operator
-- confirming a deposit is an operator reading a block explorer on a phone.
-- ---------------------------------------------------------------------------

withDepositFeed : Script (Desk, Party, ContractId DepositBook)
withDepositFeed = script do
  (k, d, _) <- books
  feed <- allocateParty "ChainWatcher"
  d2 <- submit k.principal do exerciseCmd d SetDepositFeed with feed = Some feed
  pure (k, feed, d2)

instructionFor : Desk -> ContractId DepositBook -> Script (ContractId DepositInstruction)
instructionFor k d = submit k.operator do
  exerciseCmd d IssueDepositInstruction with
    customer = k.customer; quoteRef = "KYA-F1"
    asset = "USDT"; network = "TRC20"; memo = None

-- 9. The watcher confirms a deposit it saw on chain.
testDepositFeedCanConfirmADeposit : Script ()
testDepositFeedCanConfirmADeposit = script do
  (k, feed, d) <- withDepositFeed
  inst <- instructionFor k d
  _ <- submit feed do
    exerciseCmd inst ConfirmDepositSeen with
      txRef = "0x9f2c...a41"; seenAmount = 10.0
  pure ()

-- 10. A transaction reference is required. A watcher that can confirm without
--     one is an operator's eyeball with a cron job attached.
testDepositFeedNeedsATransactionReference : Script ()
testDepositFeedNeedsATransactionReference = script do
  (k, feed, d) <- withDepositFeed
  inst <- instructionFor k d
  submitMustFail feed do
    exerciseCmd inst ConfirmDepositSeen with txRef = ""; seenAmount = 10.0

-- 11. With no feed configured the choice is unusable, including by the
--     operator who would otherwise be its controller.
testDepositFeedChoiceUnusableWithoutAFeed : Script ()
testDepositFeedChoiceUnusableWithoutAFeed = script do
  (k, d, _) <- books
  inst <- instructionFor k d
  submitMustFail k.operator do
    exerciseCmd inst ConfirmDepositSeen with txRef = "0x9f2c...a41"; seenAmount = 10.0

-- 12. The operator cannot appoint the watcher.
testOperatorCannotAppointTheDepositFeed : Script ()
testOperatorCannotAppointTheDepositFeed = script do
  (k, d, _) <- books
  feed <- allocateParty "SomethingTheOperatorControls"
  submitMustFail k.operator do
    exerciseCmd d SetDepositFeed with feed = Some feed

-- The counterparty list is the real privileged operation. Every fence in this
-- file assumes the list is right; whoever can edit the list can walk around
-- all of them by simply adding themselves to it. These choices had no test at
-- all, which meant the most valuable control in the cycle was the only one
-- nobody had attacked.
testOperatorCannotApproveAnOffTakerWallet : Script ()
testOperatorCannotApproveAnOffTakerWallet = script do
  principal <- allocateParty "Principal"
  operator  <- allocateParty "Operator"
  book <- submit principal do
    createCmd OffTakerBook with principal; operator; wallets = []
  -- The whole attack in one line: the operator adds their own wallet, then
  -- sends the desk's crypto to an address that is now "approved".
  submitMustFail operator do
    exerciseCmd book ApproveOffTakerWallet with
      offTaker = "Supplier A"; asset = "USDT"; network = "TRC20"
      address = "TOperatorOwnWallet"

testOperatorCannotWithdrawAnOffTakerWallet : Script ()
testOperatorCannotWithdrawAnOffTakerWallet = script do
  -- Removal matters as much as addition: quietly dropping the real supplier
  -- and leaving one wallet on the list makes that wallet the only choice.
  principal <- allocateParty "Principal"
  operator  <- allocateParty "Operator"
  book <- submit principal do
    createCmd OffTakerBook with
      principal
      operator
      wallets = [("Supplier A", "USDT", "TRC20", "TRealSupplierWallet")]
  submitMustFail operator do
    exerciseCmd book WithdrawOffTakerWallet with
      offTaker = "Supplier A"; asset = "USDT"; network = "TRC20"
      address = "TRealSupplierWallet"

testApprovingAWalletMakesItUsableAndOnlyThen : Script ()
testApprovingAWalletMakesItUsableAndOnlyThen = script do
  -- Both directions of the same fence, so the test cannot pass by the choice
  -- doing nothing at all.
  principal <- allocateParty "Principal"
  operator  <- allocateParty "Operator"
  empty <- submit principal do
    createCmd OffTakerBook with principal; operator; wallets = []
  submitMustFail operator do
    exerciseCmd empty SendToOffTaker with
      offTaker = "Supplier A"; asset = "USDT"; network = "TRC20"
      toAddress = "TNewSupplierWallet"; amount = 10.0; expectedNaira = 12500.0
  filled <- submit principal do
    exerciseCmd empty ApproveOffTakerWallet with
      offTaker = "Supplier A"; asset = "USDT"; network = "TRC20"
      address = "TNewSupplierWallet"
  _ <- submit operator do
    exerciseCmd filled SendToOffTaker with
      offTaker = "Supplier A"; asset = "USDT"; network = "TRC20"
      toAddress = "TNewSupplierWallet"; amount = 10.0; expectedNaira = 12500.0
  pure ()

-- ApproveDepositAddress and WithdrawOffTakerWallet were only ever exercised
-- inside submitMustFail: the tests proved the OPERATOR cannot use them and
-- never proved the principal can. `daml test --all --show-coverage` reported
-- them as never exercised, while plain `daml test` -- the command CONTRIBUTING
-- tells you to run -- printed 100% and hid it.
testPrincipalCanApproveADepositAddress : Script ()
testPrincipalCanApproveADepositAddress = script do
  principal <- allocateParty "Principal"
  operator  <- allocateParty "Operator"
  book <- submit principal do
    createCmd DepositBook with
      principal
      operator
      addresses = []
      depositFeed = None
  filled <- submit principal do
    exerciseCmd book ApproveDepositAddress with
      asset = "USDT"; network = "TRC20"
      address = "TNewDeskWallet"; memoRequired = False
  Some b <- queryContractId principal filled
  assertMsg "the address is on the book"
    (("USDT", "TRC20", "TNewDeskWallet", False) `elem` b.addresses)

testWithdrawingAWalletStopsItBeingUsed : Script ()
testWithdrawingAWalletStopsItBeingUsed = script do
  -- Both halves: the principal can withdraw, and the withdrawal actually
  -- takes the wallet out of use. A Withdraw that removed nothing would have
  -- passed a test that only checked the principal was allowed to call it.
  principal <- allocateParty "Principal"
  operator  <- allocateParty "Operator"
  book <- submit principal do
    createCmd OffTakerBook with
      principal
      operator
      wallets = [("Supplier A", "USDT", "TRC20", "TSupplierWallet")]
  _ <- submit operator do
    exerciseCmd book SendToOffTaker with
      offTaker = "Supplier A"; asset = "USDT"; network = "TRC20"
      toAddress = "TSupplierWallet"; amount = 10.0; expectedNaira = 12500.0
  emptied <- submit principal do
    exerciseCmd book WithdrawOffTakerWallet with
      offTaker = "Supplier A"; asset = "USDT"; network = "TRC20"
      address = "TSupplierWallet"
  submitMustFail operator do
    exerciseCmd emptied SendToOffTaker with
      offTaker = "Supplier A"; asset = "USDT"; network = "TRC20"
      toAddress = "TSupplierWallet"; amount = 10.0; expectedNaira = 12500.0
