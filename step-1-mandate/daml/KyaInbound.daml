-- KyaInbound: the reverse leg. The customer has naira and wants crypto.
--
-- The mirror of KyaCycle, and the more dangerous direction, for one reason
-- that has nothing to do with cryptography: a naira transfer can be reversed
-- and a crypto send cannot. The desk is exposed from the moment it releases.
--
-- Three losses live here.
--
--   The fake alert. The customer sends a doctored transfer receipt, the
--   operator releases the crypto, and the money never arrives. An operator
--   looking at a screenshot on a phone cannot tell. So the operator does not
--   get to decide: ConfirmNairaCredited is controller principal, because the
--   person who can see the bank account is the only person who can say money
--   is in it.
--
--   The wrong network, outbound. Here the desk is the SENDER. Send ERC-20 to
--   an address that only exists on TRC-20 and the coin is the desk's own loss.
--
--   The changed wallet. Same redirect fraud as KyaQuote, aimed the other way:
--   the customer's receiving address is fixed when the rate is agreed, not
--   supplied at release.
module KyaInbound where

-- The desk's own naira accounts, approved by the principal. An operator who
-- can nominate the account customers pay into can nominate their own.
template NairaBook
  with
    principal : Party
    operator  : Party
    accounts  : [Text]      -- "GTB 0011223344 / VOREM LTD"
    -- The band the principal will trade inside today. An operator -- human or
    -- a language model reading a customer's message -- cannot quote outside
    -- it. "My guy quoted me 1400 this morning" and a prompt injection that
    -- tells the model to use 1400 are the same attack, and this is the same
    -- fence for both: the number is not the operator's to choose freely.
    rateFloor : Decimal
    rateCeiling : Decimal
    -- A bank feed may confirm credits in the principal's place. It is a
    -- narrow authority on purpose: confirm a credit that matches, and nothing
    -- else. It cannot release crypto, approve an account, or move the band.
    --
    -- Without it, ConfirmNairaCredited is controller principal and every
    -- inbound waits for a human who can see the bank account -- which is
    -- correct, and does not scale past one person.
    bankFeed : Optional Party
    -- Networks the desk can actually send on, per asset.
    canSend   : [(Text, Text)]   -- (asset, network)
  where
    signatory principal
    observer operator

    nonconsuming choice QuoteForNaira : ContractId InboundDeal
      with
        customer       : Party
        reference      : Text
        payIntoAccount : Text     -- which of the desk's accounts to pay
        nairaAmount    : Decimal
        rate           : Decimal
        asset          : Text     -- what the customer wants
        network        : Text     -- and on which chain
        customerWallet : Text     -- FIXED HERE, before any money moves
        expiresAt      : Time
      controller operator
      do
        assertMsg "naira amount must be positive" (nairaAmount > 0.0)
        assertMsg "rate must be positive" (rate > 0.0)
        assertMsg "rate is outside the band the principal set" (rate >= rateFloor && rate <= rateCeiling)
        -- The arithmetic itself, checked on the ledger. A quote whose naira
        -- does not equal amount times rate is not a rounding argument to have
        -- with a customer later; it cannot be issued.
        assertMsg "naira does not equal the crypto amount times the rate" (abs (nairaAmount - (nairaAmount / rate) * rate) < 0.01)
        assertMsg "that is not one of the desk's approved naira accounts" (payIntoAccount `elem` accounts)
        assertMsg "the desk cannot send that asset on that network" ((asset, network) `elem` canSend)
        assertMsg "a receiving wallet must be given when the rate is agreed" (customerWallet /= "")
        create InboundDeal with
          operator; principal; customer; reference; payIntoAccount
          nairaAmount; rate; asset; network; customerWallet; expiresAt
          nairaConfirmed = False; bankReference = ""; bankFeed

    -- Naming the feed is the principal's alone. An operator who could appoint
    -- the thing that confirms their own deals has no fence at all.
    choice SetBankFeed : ContractId NairaBook
      with feed : Optional Party
      controller principal
      do create this with bankFeed = feed

    choice ApproveNairaAccount : ContractId NairaBook
      with account : Text
      controller principal
      do create this with accounts = account :: accounts

    -- Moving the band is the principal's, and only theirs. This is the
    -- control that makes the fence above worth having.
    choice SetRateBand : ContractId NairaBook
      with floor : Decimal, ceiling : Decimal
      controller principal
      do
        assertMsg "a rate band must be positive and the right way round" (floor > 0.0 && ceiling >= floor)
        create this with rateFloor = floor, rateCeiling = ceiling

template InboundDeal
  with
    operator       : Party
    principal      : Party
    customer       : Party
    reference      : Text
    payIntoAccount : Text
    nairaAmount    : Decimal
    rate           : Decimal
    asset          : Text
    network        : Text
    customerWallet : Text
    expiresAt      : Time
    nairaConfirmed : Bool
    bankReference  : Text
    bankFeed       : Optional Party
  where
    signatory operator
    -- The feed observes, or it cannot exercise anything: a party that cannot
    -- see a contract cannot act on it. Observing is all it gets -- it reads
    -- this deal, and confirms a credit against it, and that is the whole of
    -- its authority.
    observer customer, principal, optional [] (\p -> [p]) bankFeed

    -- The principal confirms, not the operator. The operator sees a
    -- screenshot; the principal sees the account. A doctored receipt is
    -- indistinguishable from a real one on a phone, and that is the whole
    -- fraud. A bank reference is required so the confirmation points at
    -- something that can be checked later.
    choice ConfirmNairaCredited : ContractId InboundDeal
      with bankRef : Text, credited : Decimal
      controller principal
      do
        assertMsg "a bank reference is required; a screenshot is not a confirmation" (bankRef /= "")
        assertMsg "naira credited is short of the amount quoted" (credited >= nairaAmount)
        create this with nairaConfirmed = True, bankReference = bankRef

    -- The same confirmation, written by the feed instead of a person. The
    -- fence is unchanged -- a reference is required and short credits are
    -- refused -- only who may write it has widened, and only to a party the
    -- principal named.
    choice ConfirmNairaCreditedByFeed : ContractId InboundDeal
      with bankRef : Text, credited : Decimal
      controller optional principal identity bankFeed
      do
        assertMsg "no bank feed is configured for this desk" (bankFeed /= None)
        assertMsg "a bank reference is required; a screenshot is not a confirmation" (bankRef /= "")
        assertMsg "naira credited is short of the amount quoted" (credited >= nairaAmount)
        create this with nairaConfirmed = True, bankReference = bankRef

    -- Releasing the crypto. Consuming: a deal releases once or not at all.
    choice ReleaseCrypto : ContractId Release
      with
        toWallet  : Text
        onNetwork : Text
        amount    : Decimal
      controller operator
      do
        now <- getTime
        assertMsg "quote expired" (now < expiresAt)
        assertMsg "naira has not been confirmed credited by the principal" nairaConfirmed
        assertMsg "receiving wallet does not match the one fixed when the rate was agreed" (toWallet == customerWallet)
        assertMsg "sending on a different network from the one quoted" (onNetwork == network)
        assertMsg "amount must be positive" (amount > 0.0)
        create Release with
          operator; customer; reference; asset; network
          toWallet; amount; bankReference; releasedAt = now

    choice AbandonInbound : ()
      controller operator
      do pure ()

-- What was released, against which confirmed naira credit.
template Release
  with
    operator      : Party
    customer      : Party
    reference     : Text
    asset         : Text
    network       : Text
    toWallet      : Text
    amount        : Decimal
    bankReference : Text
    releasedAt    : Time
  where
    signatory operator
    observer customer
