-- The hole everything else sat on: nothing forced an application to use the
-- journal. This suite decides whether that is now closed.
--
-- The honest headline, which test 4 proves rather than asserts: enforcement
-- holds exactly to the degree that the guardian party is SEPARATED from the
-- actor. Daml gives a submitter the authority of every party it submits as.
-- Split guardian and actor between compliance and trading and this is a
-- control. Let one person submit as both and it is a convention again.
module GuardedTest where

import DA.Foldable (forA_)
import DA.Assert ((===))
import Daml.Script

import Attempt
import Guarded hiding (owner, guardian)
import Journal
import TestAssets

data Env = Env
  with
    owner : Party
    actor : Party
    guardian : Party
    auditor : Party
    journal : ContractId AttemptJournal

env : Script Env
env = script do
  o <- allocateParty "Treasury3"
  a <- allocateParty "Bot3"
  g <- allocateParty "Compliance"
  d <- allocateParty "Auditor3"
  j <- submit [o, a, g, d] do
    createCmd AttemptJournal with
      owner = o
      actor = a
      guardian = g
      auditor = Some d
      attempts = 0
      refusals = []
  pure Env with
    owner = o
    actor = a
    guardian = g
    auditor = d
    journal = j

aSalt : Text
aSalt = "f3a81c0d9e2b47a65d18c3f0b7e94a2c"

-- 1. The journalled path works. Open an attempt, settle it, and the
--    application's own work runs inside the settlement.
testTheJournalledPathWorks : Script ()
testTheJournalledPathWorks = script do
  e <- env
  wallet <- submit [e.owner, e.guardian] do
    createCmd Wallet with holder = e.owner; guard = e.guardian; balance = 100.0

  (attempt, j1) <- submit [e.owner, e.actor] do
    exerciseCmd e.journal Open with
      salt = aSalt; action = "withdraw"; detail = "amount=1"

  _ <- submit [e.owner, e.actor] do
    exerciseCmd attempt SettleAttempt with
      salt = aSalt; action = "withdraw"; detail = "amount=1"
      target = toInterfaceContractId @Journalled wallet

  -- The work happened: a new wallet at 99.
  [(_, w)] <- query @Wallet e.owner
  w.balance === 99.0

  -- And it is counted.
  seen <- submit e.auditor do exerciseCmd j1 Expect
  seen === (1, [])

-- 2. THE TEST. The actor tries to move the asset WITHOUT a journal entry,
--    and the ledger refuses, because the actor does not hold the guardian's
--    authority.
--
--    Before Guarded.daml this succeeded and nothing recorded it.
testTheAssetCannotMoveOutsideTheJournal : Script ()
testTheAssetCannotMoveOutsideTheJournal = script do
  e <- env
  wallet <- submit [e.owner, e.guardian] do
    createCmd Wallet with holder = e.owner; guard = e.guardian; balance = 100.0

  -- Owner and actor together, with no guardian and no attempt. Refused.
  submitMustFail [e.owner, e.actor] do
    exerciseCmd (toInterfaceContractId @Journalled wallet) Perform

  -- Owner alone cannot archive it either: the guardian is a signatory.
  submitMustFail [e.owner] do
    archiveCmd wallet

  -- Nothing moved and nothing was counted.
  wallets <- query @Wallet e.owner
  length wallets === 1
  seen <- submit e.auditor do exerciseCmd e.journal Expect
  seen === (0, [])

-- 3. An asset that names a guardian in its view but leaves it off the
--    signatory line LOOKS guarded and is not. The resolution refuses it
--    rather than quietly settling something unenforced.
testAnUnguardedAssetIsRejectedAtResolution : Script ()
testAnUnguardedAssetIsRejectedAtResolution = script do
  e <- env
  loose <- submit e.owner do
    createCmd LooseWallet with
      holder = e.owner; guard = e.guardian; balance = 100.0

  (attempt, _) <- submit [e.owner, e.actor] do
    exerciseCmd e.journal Open with
      salt = aSalt; action = "withdraw"; detail = "amount=1"

  submitMustFail [e.owner, e.actor] do
    exerciseCmd attempt SettleAttempt with
      salt = aSalt; action = "withdraw"; detail = "amount=1"
      target = toInterfaceContractId @Journalled loose

-- 4. The limit of the whole design, tested rather than asserted.
--
--    If one party can submit as BOTH the actor and the guardian, Daml hands
--    it both authorities and the asset moves with no journal entry. So this
--    is a control only when the guardian is operated by someone who is not
--    the actor. Segregation of duties is doing the work; the code only makes
--    it enforceable.
--
--    If this test ever goes red, something changed in Daml's authorization
--    model and the README must change with it.
testSubmittingAsTheGuardianDefeatsIt : Script ()
testSubmittingAsTheGuardianDefeatsIt = script do
  e <- env
  wallet <- submit [e.owner, e.guardian] do
    createCmd Wallet with holder = e.owner; guard = e.guardian; balance = 100.0

  -- Submitting as the guardian too. This SUCCEEDS, with no attempt opened.
  submit [e.owner, e.guardian] do
    exerciseCmd (toInterfaceContractId @Journalled wallet) Perform

  -- The work happened and the counter never moved. That is the residual
  -- hole, and it is a question about who runs which participant, not about
  -- this code.
  seen <- submit e.auditor do exerciseCmd e.journal Expect
  seen === (0, [])

-- 5. The guardian alone cannot move it either. The control is a conjunction,
--    not a transfer of power to compliance.
testTheGuardianAloneCannotMoveIt : Script ()
testTheGuardianAloneCannotMoveIt = script do
  e <- env
  wallet <- submit [e.owner, e.guardian] do
    createCmd Wallet with holder = e.owner; guard = e.guardian; balance = 100.0
  submitMustFail [e.guardian] do
    exerciseCmd (toInterfaceContractId @Journalled wallet) Perform
  submitMustFail [e.guardian] do
    archiveCmd wallet

-- 6. A refused attempt moves nothing, and the asset is untouched. The
--    refusal branch never reaches the application's work at all.
testARefusedAttemptNeverTouchesTheAsset : Script ()
testARefusedAttemptNeverTouchesTheAsset = script do
  e <- env
  wallet <- submit [e.owner, e.guardian] do
    createCmd Wallet with holder = e.owner; guard = e.guardian; balance = 100.0

  (attempt, j1) <- submit [e.owner, e.actor] do
    exerciseCmd e.journal Open with
      salt = aSalt; action = "withdraw"; detail = "amount=900000"

  (record, _) <- submit [e.owner, e.actor] do
    exerciseCmd attempt RefuseAttempt with
      salt = aSalt; action = "withdraw"; detail = "amount=900000"
      rule = "above the per-day ceiling"

  Some r <- queryContractId e.auditor record
  r.rule === "above the per-day ceiling"

  [(_, w)] <- query @Wallet e.owner
  w.balance === 100.0

  -- One attempt counted. `refusals` stays empty on purpose: in the two-phase
  -- flow the journal cannot know at open time which way an attempt will go,
  -- so the auditor reconciles against the refusal records and the resolution
  -- markers instead of reading a list off the journal.
  seen <- submit e.auditor do exerciseCmd j1 Expect
  seen === (1, [])

-- 7. The gap Georgi Radev named on 27 October 2026, proven rather than
--    accepted: a guardian on the signatory line does NOT gate a choice the
--    owner controls. Controllers authorize the exercise, and a consuming
--    choice archives its own contract on the controller's authority alone;
--    signatory authority is required to create, not to archive this way.
--
--    So an asset that passes assertGuarded, names the guardian correctly and
--    would satisfy every other test in this file still moves outside the
--    journal if it carries one ordinary owner-controlled choice. Wallet does
--    not carry one, which is why nothing here caught this before.
--
--    This is a specification hole, not a code defect. The fix belongs in the
--    CIP as a requirement on implementers, and this test is what makes the
--    requirement checkable.
testAnOwnerControlledChoiceStillBypassesTheJournal : Script ()
testAnOwnerControlledChoiceStillBypassesTheJournal = script do
  e <- env
  wallet <- submit [e.owner, e.guardian] do
    createCmd SpendableWallet with
      holder = e.owner; guard = e.guardian; balance = 100.0

  -- It is guarded by every measure this suite had: the guardian is a
  -- signatory, and the interface route is refused without their authority.
  submitMustFail [e.owner, e.actor] do
    exerciseCmd (toInterfaceContractId @Journalled wallet) Perform

  -- And yet the owner alone consumes it, with no guardian and no attempt.
  submit [e.owner] do
    exerciseCmd wallet Spend with amount = 100.0

  -- The asset is gone and the journal never moved.
  remaining <- query @SpendableWallet e.owner
  length remaining === 0
  seen <- submit e.auditor do exerciseCmd e.journal Expect
  seen === (0, [])

-- 8. THE LIMIT THE BINANCE HACK MAKES VISIBLE, written down on 31 October
--    2026, two days after about USD 6.3bn left Binance through what early
--    reporting describes as one engineer's compromised laptop.
--
--    The guarded asset survives a single stolen key: tests 2, 4 and 5 above
--    show that owner and actor together move nothing, and that the guardian
--    alone moves nothing either. The control is a conjunction.
--
--    What does NOT survive is the EVIDENCE. An attacker holding one party's
--    authority does not open an attempt, because opening one gains them
--    nothing. They exercise the asset directly, the ledger refuses during
--    interpretation, no transaction commits, and the counter never moves. So
--    the owner cannot afterwards prove "we were attacked and blocked it",
--    which is the exact sentence this package exists to make provable.
--
--    The journal counts refusals by a COOPERATING actor. It does not count
--    attacks. That is a real limit of the design and it is better stated here
--    by its author than discovered by a reader after an incident.
--
--    What would count an attack is a different mechanism: the participant's
--    own rejection log, or the confirmation-stage verdicts the mediator
--    stores, which Leonid set out on forum topic 9114 on 30 October 2026 and
--    which Splice Scan publishes on /v0/events. Those see a transaction that
--    reached confirmation. They do not see this one either, because an
--    authorization failure at the submitter never becomes a confirmation
--    request.
testAnAttackerWithOneStolenKeyLeavesNoCount : Script ()
testAnAttackerWithOneStolenKeyLeavesNoCount = script do
  e <- env
  wallet <- submit [e.owner, e.guardian] do
    createCmd Wallet with holder = e.owner; guard = e.guardian; balance = 100.0

  -- Five attempts with the owner's authority alone, as a stolen key would
  -- have. Every one is refused by the ledger.
  forA_ [1, 2, 3, 4, 5] $ \_ ->
    submitMustFail [e.owner] do
      exerciseCmd (toInterfaceContractId @Journalled wallet) Perform

  -- The asset is untouched, which is the control working.
  [(_, w)] <- query @Wallet e.owner
  w.balance === 100.0

  -- And the auditor sees nothing at all. Not five refusals. Not one. The
  -- attack is invisible, and that is the limit.
  seen <- submit e.auditor do exerciseCmd e.journal Expect
  seen === (0, [])
