-- The point of this suite is the detection, not the template.
--
-- Every test here is written so that it goes red if the journal stops being
-- able to catch a specific lie. A suite that only proves the counter counts
-- would stay green through the removal of the thing the module is for.
module JournalTest where

import DA.Assert ((===))
import Daml.Script
import Journal
import Refusal

data Setup = Setup
  with
    owner : Party
    actor : Party
    guardian : Party
    auditor : Party
    journal : ContractId AttemptJournal

-- A journal with an auditor named in advance, which is the only interesting
-- configuration. `auditor = None` is covered by test 7.
setup : Script Setup
setup = script do
  o <- allocateParty "Treasury"
  a <- allocateParty "RebalanceBot"
  g <- allocateParty "Compliance1"
  d <- allocateParty "Auditor"
  j <- submit [o, a, g, d] do
    createCmd AttemptJournal with
      owner = o
      actor = a
      guardian = g
      auditor = Some d
      attempts = 0
      refusals = []
  pure Setup with
    owner = o
    actor = a
    guardian = g
    auditor = d
    journal = j

-- 1. Both paths increment. If `Allow` ever stops counting, the denominator
--    becomes the count of refusals and the auditor's arithmetic is destroyed
--    while every refusal is still perfectly recorded. That is the failure
--    mode this module exists to prevent, so it is test one.
testBothPathsCount : Script ()
testBothPathsCount = script do
  s <- setup
  j1 <- submit [s.owner, s.actor] do
    exerciseCmd s.journal Allow with action = "withdraw"
  (_, j2) <- submit [s.owner, s.actor] do
    exerciseCmd j1 Refuse with
      action = "withdraw"
      detail = "amount=900000"
      rule = "above the per-day ceiling"
  j3 <- submit [s.owner, s.actor] do
    exerciseCmd j2 Allow with action = "withdraw"
  Some journal <- queryContractId s.owner j3
  journal.attempts === 3
  journal.refusals === [2]

-- 2. The auditor reads the count themselves, as the auditor, without the
--    owner or the actor submitting anything. This is the difference between
--    evidence and a report: if `Expect` ever needs the operator's signature,
--    the operator is back in the loop and the number is theirs again.
testTheAuditorReadsTheCountWithoutTheOperator : Script ()
testTheAuditorReadsTheCountWithoutTheOperator = script do
  s <- setup
  (_, j1) <- submit [s.owner, s.actor] do
    exerciseCmd s.journal Refuse with
      action = "settle"
      detail = "ccy=USD"
      rule = "counterparty is not on the allow-list"
  j2 <- submit [s.owner, s.actor] do
    exerciseCmd j1 Allow with action = "settle"
  seen <- submit s.auditor do
    exerciseCmd j2 Expect
  seen === (2, [1])

-- 3. The whole objection, as a test. The operator refuses three times and
--    hands the auditor two records. The auditor catches it, and catches
--    WHICH position is missing, from the journal alone.
testAWithheldRefusalIsDetectable : Script ()
testAWithheldRefusalIsDetectable = script do
  s <- setup
  (r1, j1) <- submit [s.owner, s.actor] do
    exerciseCmd s.journal Refuse with
      action = "withdraw"; detail = "amount=1"; rule = "cap"
  j2 <- submit [s.owner, s.actor] do
    exerciseCmd j1 Allow with action = "withdraw"
  (r3, j3) <- submit [s.owner, s.actor] do
    exerciseCmd j2 Refuse with
      action = "withdraw"; detail = "amount=2"; rule = "cap"
  (_, j4) <- submit [s.owner, s.actor] do
    exerciseCmd j3 Refuse with
      action = "withdraw"; detail = "amount=3"; rule = "allow-list"
  expected <- submit s.auditor do
    exerciseCmd j4 Expect
  expected === (4, [1, 3, 4])

  -- Everything handed over: nothing missing.
  missingRefusals expected [1, 3, 4] === []

  -- The fourth withheld: the auditor names the position without ever having
  -- seen its contents.
  missingRefusals expected [1, 3] === [4]

  -- A record invented for a position the journal never refused is the other
  -- half of the same lie, and is also caught.
  missingRefusals expected [1, 3, 4, 2] === [2]

  -- The two records the auditor WAS given are readable, so the test is not
  -- passing on an auditor who can read nothing.
  Some first <- queryContractId s.auditor r1
  Some third <- queryContractId s.auditor r3
  first.rule === "cap"
  third.rule === "cap"

-- 4. The selective-disclosure half, which is the part a transparent ledger
--    cannot do and the part RFP 27 asks for by name. The auditor learns that
--    an allowed attempt happened and learns nothing else about it. If an
--    AcceptanceRecord is ever "helpfully" added, this goes red.
testTheAuditorCannotSeeWhatWasAllowed : Script ()
testTheAuditorCannotSeeWhatWasAllowed = script do
  s <- setup
  j1 <- submit [s.owner, s.actor] do
    exerciseCmd s.journal Allow with action = "pay the supplier 40000"
  seen <- submit s.auditor do
    exerciseCmd j1 Expect
  seen === (1, [])
  -- One attempt, nothing refused, and no contract anywhere the auditor can
  -- read that says what it was.
  records <- query @RefusalRecord s.auditor
  length records === 0

-- 5. A party nobody named cannot read the denominator either. The count is
--    disclosed to one party chosen in advance, not published.
testAStrangerCannotReadTheCount : Script ()
testAStrangerCannotReadTheCount = script do
  s <- setup
  stranger <- allocateParty "Stranger"
  submitMustFail stranger do
    exerciseCmd s.journal Expect
  records <- query @AttemptJournal stranger
  length records === 0

-- 6. The owner can still read their own count with no auditor named, so the
--    controller is a disjunction and not an auditor-only choice.
testTheOwnerCanReadTheirOwnCount : Script ()
testTheOwnerCanReadTheirOwnCount = script do
  owner <- allocateParty "Fund"
  actor <- allocateParty "Bot"
  guardian <- allocateParty "G1"
  j <- submit [owner, actor, guardian] do
    createCmd AttemptJournal with
      owner = owner
      actor = actor
      guardian = guardian
      auditor = None
      attempts = 0
      refusals = []
  j1 <- submit [owner, actor] do
    exerciseCmd j Allow with action = "rebalance"
  seen <- submit owner do
    exerciseCmd j1 Expect
  seen === (1, [])

-- 7. With no auditor named, the refusals the journal writes disclose to
--    nobody beyond the two signatories. The default is private.
testNoAuditorMeansNoDisclosure : Script ()
testNoAuditorMeansNoDisclosure = script do
  owner <- allocateParty "Fund2"
  actor <- allocateParty "Bot2"
  guardian <- allocateParty "G2"
  nosy  <- allocateParty "Nosy"
  j <- submit [owner, actor, guardian] do
    createCmd AttemptJournal with
      owner = owner
      actor = actor
      guardian = guardian
      auditor = None
      attempts = 0
      refusals = []
  _ <- submit [owner, actor] do
    exerciseCmd j Refuse with
      action = "withdraw"; detail = "amount=5"; rule = "cap"
  records <- query @RefusalRecord nosy
  length records === 0

-- 8. A second journal for the same pair is PREVENTED, not merely detected.
--
--    This file previously gave up here, and for a reason that was wrong
--    twice over. The note said Daml-LF 2.1 removed contract keys so a second
--    journal could only be shown to the auditor. Keys returned in LF 2.3
--    (Canton 3.5.1, 27 May 2026), and they are explicitly non-unique with
--    unvalidated negative lookups, so they could not have refused one
--    anyway.
--
--    PREDGE corrected that on forum.canton.network/t/9114 on 21 October 2026:
--    a create needs the authority of EVERY signatory, so putting the auditor
--    on the signatory line makes a second journal impossible to open without
--    them. No keys required.
--
--    It costs nothing at runtime, because a choice that recreates the journal
--    already carries its signatories' authority. The auditor is needed only
--    to open one, which is the single moment you want them involved.
testASecondJournalIsPrevented : Script ()
testASecondJournalIsPrevented = script do
  s <- setup
  _ <- submit [s.owner, s.actor] do
    exerciseCmd s.journal Allow with action = "withdraw"

  -- The operator tries to open a second journal behind the auditor's back.
  -- This now FAILS. Before 21 October it succeeded.
  submitMustFail [s.owner, s.actor, s.guardian] do
    createCmd AttemptJournal with
      owner = s.owner
      actor = s.actor
      guardian = s.guardian
      auditor = Some s.auditor
      attempts = 0
      refusals = []

  -- Naming a DIFFERENT auditor does not help either: that journal simply is
  -- not one this auditor is on, and the one they are on still shows the
  -- real count.
  rival <- allocateParty "RivalAuditor"
  submitMustFail [s.owner, s.actor, s.guardian] do
    createCmd AttemptJournal with
      owner = s.owner
      actor = s.actor
      guardian = s.guardian
      auditor = Some rival
      attempts = 0
      refusals = []

  -- With the auditor it succeeds, which is correct: a second journal opened
  -- in the open, with the auditor's authority, is a decision rather than a
  -- concealment.
  _ <- submit [s.owner, s.actor, s.guardian, s.auditor] do
    createCmd AttemptJournal with
      owner = s.owner
      actor = s.actor
      guardian = s.guardian
      auditor = Some s.auditor
      attempts = 0
      refusals = []
  live <- query @AttemptJournal s.auditor
  length live === 2

-- 8b. The guarantee is exactly as strong as naming an auditor. With `None`
--     there is no third signatory and a second journal can be opened freely.
--     Tested so the limit cannot be forgotten.
testWithNoAuditorASecondJournalIsStillPossible : Script ()
testWithNoAuditorASecondJournalIsStillPossible = script do
  owner <- allocateParty "FundNA"
  actor <- allocateParty "BotNA"
  guardian <- allocateParty "GNA"
  _ <- submit [owner, actor, guardian] do
    createCmd AttemptJournal with
      owner; actor; guardian
      auditor = None
      attempts = 0
      refusals = []
  _ <- submit [owner, actor, guardian] do
    createCmd AttemptJournal with
      owner; actor; guardian
      auditor = None
      attempts = 0
      refusals = []
  live <- query @AttemptJournal owner
  length live === 2

-- 9. The count is monotonic because every attempt consumes the journal. The
--     contract id from before an attempt is dead afterwards, so there is no
--     earlier journal to go back to and no way to replay a lower number.
testTheCountCannotBeRewound : Script ()
testTheCountCannotBeRewound = script do
  s <- setup
  j1 <- submit [s.owner, s.actor] do
    exerciseCmd s.journal Allow with action = "withdraw"
  (_, j2) <- submit [s.owner, s.actor] do
    exerciseCmd j1 Refuse with
      action = "withdraw"; detail = "amount=7"; rule = "cap"
  seen <- submit s.auditor do
    exerciseCmd j2 Expect
  seen === (2, [2])

  -- The original journal is archived, and exercising it again fails rather
  -- than quietly producing a stale count.
  gone <- queryContractId s.owner s.journal
  gone === None
  submitMustFail [s.owner, s.actor] do
    exerciseCmd s.journal Allow with action = "withdraw"
  submitMustFail [s.owner, s.actor] do
    exerciseCmd j1 Allow with action = "withdraw"

-- 10. A journal claiming more refusals than attempts cannot be created. The
--     `ensure` is the only thing standing between the auditor and a
--     denominator smaller than its own numerator.
testRefusalsCannotExceedAttempts : Script ()
testRefusalsCannotExceedAttempts = script do
  owner <- allocateParty "Fund3"
  actor <- allocateParty "Bot3"
  guardian <- allocateParty "G3"
  submitMustFail [owner, actor, guardian] do
    createCmd AttemptJournal with
      owner = owner
      actor = actor
      guardian = guardian
      auditor = None
      attempts = 1
      refusals = [1, 2]
  submitMustFail [owner, actor, guardian] do
    createCmd AttemptJournal with
      owner = owner
      actor = actor
      guardian = guardian
      auditor = None
      attempts = -1
      refusals = []
  pure ()

-- 11. The honest limit, written as a test so nobody can claim more than this.
--     An attempt that never touches the journal leaves the count untouched.
--     This module moves the hole to a code path a reviewer can look for; it
--     does not close it. If this test ever goes red, the claim got bigger
--     than the code and the README must change with it.
testAnUnjournalledAttemptIsStillInvisible : Script ()
testAnUnjournalledAttemptIsStillInvisible = script do
  s <- setup
  j1 <- submit [s.owner, s.actor] do
    exerciseCmd s.journal Allow with action = "withdraw"

  -- The operator writes a RefusalRecord directly, going around the journal
  -- entirely. It succeeds, because Refusal.daml is a standalone template and
  -- always was.
  now <- getTime
  _ <- submit [s.owner, s.actor] do
    createCmd RefusalRecord with
      owner = s.owner
      actor = s.actor
      action = "withdraw"
      detail = "amount=99"
      rule = "cap"
      refusedAt = now
      auditor = Some s.auditor
  -- The count did not move. The auditor sees one attempt and no refused
  -- positions, while a refusal record exists. Unjournalled activity is
  -- invisible TO THE COUNT, and that is the limit, stated.
  seen <- submit s.auditor do
    exerciseCmd j1 Expect
  seen === (1, [])

-- 12. Arpit Karnatak of Vacuumlabs raised this on forum 9084 on 18 October
--     2026, and he was right. It is the sharpest objection anyone has made to
--     this design, so it gets a test rather than a paragraph.
--
--     His case: the check PASSES, the work proceeds, and then something later
--     in the same transaction reverts. Daml commits whole or not at all, so
--     the rollback takes the count with it. The attempt leaves nothing.
--
--     That is the other face of the property test 9 relies on. The work and
--     the count cannot come apart, which is exactly why they also die
--     together. You cannot have both: write the record in the same
--     transaction and they are inseparable but both vanish on a revert; write
--     it first in its own transaction and it survives but no longer matches
--     what happened.
--
--     The refuse branch does NOT have this problem, and that asymmetry is the
--     answer. When the check says no, the record is the only thing in the
--     transaction. There is no later step that can revert it. Test 13 holds
--     that line.
testAnAllowedAttemptThatRevertsIsLost : Script ()
testAnAllowedAttemptThatRevertsIsLost = script do
  s <- setup
  j1 <- submit [s.owner, s.actor] do
    exerciseCmd s.journal Allow with action = "withdraw"

  -- One transaction: the journal increments, then the work fails. An empty
  -- `action` breaks RefusalRecord's `ensure`, standing in for any later step
  -- that reverts. Written with `*>` because Commands is applicative, not
  -- monadic: two commands in one submission are one transaction.
  now <- getTime
  submitMustFail [s.owner, s.actor] $
    exerciseCmd j1 Allow with action = "withdraw"
      *> createCmd RefusalRecord with
           owner = s.owner
           actor = s.actor
           action = ""
           detail = "the work that reverted"
           rule = "irrelevant, this never commits"
           refusedAt = now
           auditor = None

  -- The count did not move. One attempt on the ledger, two in the world.
  seen <- submit s.auditor do
    exerciseCmd j1 Expect
  seen === (1, [])

-- 13. The asymmetry that makes the design still worth having. A refusal is
--     the ONLY thing in its transaction, so there is no later step that can
--     take it down with it. Test 12's failure mode cannot reach this branch.
testARefusalHasNothingLaterThatCanRevertIt : Script ()
testARefusalHasNothingLaterThatCanRevertIt = script do
  s <- setup
  (record, j1) <- submit [s.owner, s.actor] do
    exerciseCmd s.journal Refuse with
      action = "withdraw"
      detail = "amount=900000"
      rule = "above the per-day ceiling"

  -- Committed, readable by the auditor, and the count moved.
  Some r <- queryContractId s.auditor record
  r.rule === "above the per-day ceiling"
  seen <- submit s.auditor do
    exerciseCmd j1 Expect
  seen === (1, [1])

  -- And a later transaction that reverts cannot reach back and undo it.
  now <- getTime
  submitMustFail [s.owner, s.actor] do
    createCmd RefusalRecord with
      owner = s.owner
      actor = s.actor
      action = ""
      detail = "a later failure"
      rule = "irrelevant"
      refusedAt = now
      auditor = None
  Some still <- queryContractId s.auditor record
  still.rule === "above the per-day ceiling"

-- Simon Meier, cip-discuss, 2026-10-30: "creating contracts to store
-- notifications is a storage leak and an anti-pattern ... The better way to
-- signal events is through non-consuming choices." He is the author of
-- CIP-0112, which specifies exactly that as the token standard's EventLog.
--
-- He is right, and these two tests are the measurement of what his mechanism
-- buys and what it costs, so the choice between them is made on numbers.
--
-- 1. RefuseSignalled costs no contract. The count moves, the position is
--    recorded, the auditor is told, and the active contract set does not grow.
testSignallingCostsNoContract : Script ()
testSignallingCostsNoContract = script do
  s <- setup

  before <- query @RefusalRecord s.owner
  j1 <- submit [s.owner, s.actor] do
    exerciseCmd s.journal RefuseSignalled with
      action = "withdraw"; detail = "amount=500"; rule = "dailyCap"
  after <- query @RefusalRecord s.owner

  -- Not one contract was created for it.
  length after === length before

  -- The auditor still learns that one attempt happened and was refused.
  seen <- submit s.auditor do exerciseCmd j1 Expect
  seen === (1, [1])

-- 2. The cost of that, stated as a test rather than as a paragraph. A
--    signalled refusal and a refusal whose reason was deliberately withheld
--    leave the SAME active contract set: a numbered position with nothing
--    behind it. They are told apart only by the update stream, which Canton's
--    pruning reference says a pruned node can no longer serve.
--
--    This test cannot prune a participant, so it does not claim to. It proves
--    the weaker thing that is still the point: once the events are gone, the
--    two cases are identical on the ledger, and the party who can prune is the
--    party being audited.
testASignalledRefusalLooksWithheldOnceEventsAreGone : Script ()
testASignalledRefusalLooksWithheldOnceEventsAreGone = script do
  s <- setup

  signalled <- submit [s.owner, s.actor] do
    exerciseCmd s.journal RefuseSignalled with
      action = "withdraw"; detail = "amount=500"; rule = "dailyCap"

  -- A second journal, same shape, whose refusal DID write a record.
  o2 <- allocateParty "Treasury9"
  a2 <- allocateParty "Bot9"
  g2 <- allocateParty "Compliance9"
  d2 <- allocateParty "Auditor9"
  j2 <- submit [o2, a2, g2, d2] do
    createCmd AttemptJournal with
      owner = o2; actor = a2; guardian = g2; auditor = Some d2
      attempts = 0; refusals = []
  (record, recorded) <- submit [o2, a2] do
    exerciseCmd j2 Refuse with
      action = "withdraw"; detail = "amount=500"; rule = "dailyCap"

  -- Both auditors see the identical count and the identical position.
  seen1 <- submit s.auditor do exerciseCmd signalled Expect
  seen2 <- submit d2 do exerciseCmd recorded Expect
  seen1 === seen2

  -- The difference is entirely in what survives as a contract. Canton's
  -- pruning reference: pruning "never removes active ... contracts", and a
  -- pruned node "will not be able to serve events that precede t".
  withheld <- query @RefusalRecord s.owner
  length withheld === 0
  kept <- query @RefusalRecord o2
  length kept === 1
  Some r <- queryContractId o2 record
  r.rule === "dailyCap"
